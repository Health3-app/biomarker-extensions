{
  "manifest_version": 3,
  "name": "Health3 Biomarker Unit Converter",
  "version": "1.0.0",
  "description": "Convert biomarker lab values between units (mg/dL ↔ mmol/L, ng/mL ↔ nmol/L, and more). Free tool by Health3.",
  "permissions": [],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["shared/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
